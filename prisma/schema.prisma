generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "saferoute"]
}

// ============================================
// RBAC Schema (tidak diubah)
// ============================================

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  first_name String
  last_name  String
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  position_id String
  position    Position @relation(fields: [position_id], references: [id])

  @@map("users")
  @@schema("saferoute")
}

model Position {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  users                User[]
  position_permissions PositionPermission[]

  @@map("positions")
  @@schema("saferoute")
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  resource    String
  action      String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  position_permissions PositionPermission[]

  @@map("permissions")
  @@schema("saferoute")
}

model PositionPermission {
  id            String   @id @default(uuid())
  position_id   String
  permission_id String
  created_at    DateTime @default(now())

  position   Position   @relation(fields: [position_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([position_id, permission_id])
  @@map("position_permissions")
  @@schema("saferoute")
}

// ============================================
// Saferoute Schema
// ============================================

model Layer {
  id           String @id @default(uuid())
  code         String @unique
  name         String
  geometryType String @map("geometry_type")

  features Feature[]

  @@map("layer")
  @@schema("saferoute")
}

model Feature {
  id       String              @id @default(uuid())
  layerId  String              @map("layer_id")
  geom     Unsupported("geometry")
  sourceId String?             @map("source_id")

  layer    Layer      @relation(fields: [layerId], references: [id])
  roadNode RoadNode?
  roadEdge RoadEdge?
  school   School?

  @@index([layerId])
  @@index([sourceId])
  @@map("feature")
  @@schema("saferoute")
}

model Road {
  id             String  @id @default(uuid())
  osmWayId       String  @unique @map("osm_way_id")
  name           String?
  highway        String?
  maxspeedKmh    Int?    @map("maxspeed_kmh")
  maxspeedStatus String  @default("missing") @map("maxspeed_status")
  surface        String?
  surfaceStatus  String  @default("missing") @map("surface_status")
  sidewalk       String?
  sidewalkStatus String  @default("missing") @map("sidewalk_status")
  access         String?
  tags           Json?

  edges RoadEdge[]

  @@map("road")
  @@schema("saferoute")
}

model RoadNode {
  id        String  @id @default(uuid())
  featureId String  @unique @map("feature_id")
  osmNodeId String? @map("osm_node_id")

  feature  Feature    @relation(fields: [featureId], references: [id])
  outEdges RoadEdge[] @relation("EdgeSource")
  inEdges  RoadEdge[] @relation("EdgeTarget")
  accessPoints SchoolAccessPoint[]

  @@index([osmNodeId])
  @@map("road_node")
  @@schema("saferoute")
}

model RoadEdge {
  id            String  @id @default(uuid())
  roadId        String  @map("road_id")
  featureId     String  @unique @map("feature_id")
  sourceNodeId  String  @map("source_node_id")
  targetNodeId  String  @map("target_node_id")
  seqInRoad      Int?    @map("seq_in_road")
  distanceM     Float   @map("distance_m")
  travelTimeS   Float   @map("travel_time_s")
  isRoutable    Boolean @default(true) @map("is_routable")
  costSafe      Float?  @map("cost_safe")
  costBalanced  Float?  @map("cost_balanced")

  road       Road     @relation(fields: [roadId], references: [id])
  feature    Feature  @relation(fields: [featureId], references: [id])
  sourceNode RoadNode @relation("EdgeSource", fields: [sourceNodeId], references: [id])
  targetNode RoadNode @relation("EdgeTarget", fields: [targetNodeId], references: [id])

  @@index([roadId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("road_edge")
  @@schema("saferoute")
}

model School {
  id        String  @id @default(uuid())
  npsn      String? @unique
  name      String
  level     String?
  status    String?
  address   String?
  kelurahan String?
  kecamatan String?
  featureId String  @unique @map("feature_id")

  feature      Feature             @relation(fields: [featureId], references: [id])
  accessPoints SchoolAccessPoint[]

  @@map("school")
  @@schema("saferoute")
}

model SchoolAccessPoint {
  id            String @id @default(uuid())
  schoolId      String @map("school_id")
  roadNodeId    String @map("road_node_id")
  snapDistanceM Float? @map("snap_distance_m")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roadNode RoadNode @relation(fields: [roadNodeId], references: [id])

  @@unique([schoolId, roadNodeId])
  @@map("school_access_point")
  @@schema("saferoute")
}