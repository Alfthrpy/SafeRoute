# Application
NODE_ENV=development
PORT=3000
APP_NAME=my-app

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/__DATABASE_NAME__?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=30d

# Password reset email (MAIL_FROM must use a verified Resend domain in production)
RESEND_API_KEY=your-resend-api-key
MAIL_FROM="SafeRoute <noreply@your-verified-domain.com>"
FRONTEND_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3001

# API
API_PREFIX=api

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
